/* sagex styling (Textual CSS). Loaded by SagexApp via CSS_PATH = "app.tcss". */

Horizontal {
    height: 1fr;                 /* fill space between header and footer */
}

/* One uniform background: make the header, footer, AND the tree all
   transparent so the single screen background shows through everywhere. */
Header, Footer, Tree {
    background: transparent;
}

#resources-panel {
    width: 30%;                  /* left panel takes 30% of the width */
    border: round $primary;
}
#resources {
    height: 1fr;                 /* tree fills the panel above the status bar */
}
#workspace-input {
    height: auto;               /* the local-env path box (shown only in local) */
}
#workspace-tree {
    height: 1fr;                 /* local file tree fills the same space */
}
#resources-status {
    height: auto;               /* 0 rows when empty, one line when it has text */
    color: $text-muted;
    padding: 0 1;
}

/* Right: the terminal-style transcript — entries flow down to the prompt line. */
#chat-log {
    width: 70%;                  /* the remaining 70% */
    height: 1fr;
    padding: 0 1;
}
#welcome {
    width: auto;                 /* hug the banner text… */
    max-width: 100%;             /* …but wrap, not clip, on a narrow terminal */
    border: round #d77757;
    padding: 0 1;
}
#command-activity {
    margin-top: 1;
}
#prompt-row {
    height: auto;
    margin-top: 1;               /* a blank line above the prompt, like a fresh turn */
}
#prompt-glyph {
    width: 2;
    color: #d77757;              /* the same accent as the ❯ on past entries */
    text-style: bold;
}
#chat-input, #chat-input:focus {
    width: 1fr;
    background: transparent;     /* no box: you type straight onto the line */
    background-tint: transparent;
}
#prompt-status {
    height: auto;
    color: $text-muted;
}
