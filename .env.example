# sagex build settings. Copy to .env and fill in:   cp .env.example .env
#
# These are BAKED INTO THE PACKAGE at build time (setup.py writes sagex/_env.py),
# so they ship publicly in every wheel. Never put secrets here.
#
# This file is the schema: only the keys listed here are baked. To add a setting,
# add it here AND to .env, then re-run `pip install -e .`. Releases build their
# .env from GitHub repository variables with the same names.

# The Autosage API sagex talks to. Users can still override it at runtime with
# the SAGEX_API_URL environment variable.
SAGEX_API_URL=https://api.example.com

# The Autosage web app, linked from `sagex auth login` and the terminal app.
SAGEX_WEB_URL=https://app.example.com
